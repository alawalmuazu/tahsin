# SmartSchool — Git Ignore Rules
# ════════════════════════════════════════════════════════════════
# Environment & Secrets (NEVER commit these)
.env
.env.local
.env.production

# Application logs
application/logs/*.log
application/logs/log-*.php
!application/logs/index.html

# Cache files
application/cache/*
!application/cache/index.html

# Generated admission-slip QR / mPDF scratch files
uploads/temp/qr_code/*.png
uploads/temp/mpdf/*

# System directories
system/
application/config/database.php
application/config/config.php
application/config/purchase_key.php
.user.ini

# Node/npm (if any tooling added)
node_modules/
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes

# IDE files
.vscode/
.idea/
.cursor/
.github/
*.swp
*.swo

# Lighthouse audit temp files
lh_audit.mjs
