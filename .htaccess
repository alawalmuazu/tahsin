<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?/$1 [L]
</IfModule>

# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY HEADERS
# Hides server info, blocks common attacks, adds clickjacking protection
# ═══════════════════════════════════════════════════════════════════════════════

# Hide Apache version and OS from response headers
ServerSignature Off

<IfModule mod_headers.c>
    # Prevent MIME-type sniffing (stops browsers guessing file types)
    Header always set X-Content-Type-Options "nosniff"

    # Clickjacking protection — only allow framing from same origin
    Header always set X-Frame-Options "SAMEORIGIN"

    # XSS Protection for older browsers (Chrome/Edge use CSP instead)
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer policy — send referrer only on same-origin requests
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions policy — disable features this app doesn't need
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # Remove PHP version header leak
    Header unset X-Powered-By

    # HSTS — enforce HTTPS for 1 year (enable ONLY after SSL is confirmed working)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ═══════════════════════════════════════════════════════════════════════════════
# GZIP / DEFLATE COMPRESSION
# Compresses HTML, CSS, JS before sending — reduces transfer size ~70%
# ═══════════════════════════════════════════════════════════════════════════════
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2

    # Don't compress already-compressed formats
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|zip|gz|bz2|rar|pdf)$ no-gzip dont-vary
</IfModule>

# ═══════════════════════════════════════════════════════════════════════════════
# BROWSER CACHING
# Tells browsers how long to cache static assets
# Version-stamped files (ramom.css?v=xxx) can be cached for 1 year safely
# ═══════════════════════════════════════════════════════════════════════════════
<IfModule mod_expires.c>
    ExpiresActive On

    # Default: 1 week
    ExpiresDefault "access plus 1 week"

    # HTML/PHP — no cache (dynamic content)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS & JavaScript — 1 year (all files are version-stamped with ?v=)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images — 1 month
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts — 1 year (never change)
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY — Block direct access to sensitive paths
# ═══════════════════════════════════════════════════════════════════════════════

# Block access to hidden files (.env, .git, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block direct PHP execution in uploads folder
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.(php|phtml|php3|php4|php5|pl|py|jsp|asp|sh|cgi)$ - [F,NC]
</IfModule>

# Block access to application source files
<FilesMatch "\.(log|sql|md|gitignore|env|lock|json|yml|yaml|ini|conf)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ═══════════════════════════════════════════════════════════════════════════════
# PERFORMANCE — ETag & Cache-Control
# ═══════════════════════════════════════════════════════════════════════════════
<IfModule mod_headers.c>
    # Add Cache-Control immutable for versioned assets (tells browser never re-request)
    <FilesMatch "\.(css|js|woff|woff2|ttf|eot|svg)$">
        Header append Cache-Control "public, immutable"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|ico)$">
        Header append Cache-Control "public"
    </FilesMatch>
</IfModule>

# Disable ETags (avoids Last-Modified + ETag double-validation)
FileETag None